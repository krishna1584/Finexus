# Finexus frontend settings. Copy to frontend/.env (never commit the real one).

# Where the API gateway is. Leave empty in development: Vite forwards API calls
# to http://localhost:8088 (see vite.config.ts). Set it for a production build.
VITE_API_BASE_URL=

# true = demo mode: the app uses built-in sample data (src/services/mock) and
# needs no backend. Sign in with demo@finexus.com / password123.
VITE_USE_MOCK_DATA=false
