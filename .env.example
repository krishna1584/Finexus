# Banking Application Environment Variables
# Copy this file to .env and update the values as needed

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB_NAME=banking
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# Keycloak Configuration (if using OAuth2)
KEYCLOAK_URL=http://localhost:8571/
KEYCLOAK_REALM=banking-service

# Service Registry
EUREKA_URL=http://localhost:8761/eureka/

# API Gateway
API_GATEWAY_URL=http://localhost:8088

# Frontend
REACT_APP_API_BASE_URL=http://localhost:8088