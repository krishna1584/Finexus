# Finexus backend settings
# Copy this file to backend/.env and fill in the values. start-services.bat loads it.
# Never commit the real .env.

# ---- MySQL ----
# All services connect to this database by default; each service creates its own
# tables in it (spring.jpa.hibernate.ddl-auto=update). The database must exist.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB_NAME=finexus
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# ---- Login tokens ----
# Shared by User-Service (signs tokens) and API-Gateway (checks them).
# Must be base64 and at least 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=replace_with_a_base64_secret

# ---- CORS ----
# Browser origins allowed to call the API gateway (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173
