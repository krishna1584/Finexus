# Banking Application Environment Variables
# Copy this file to .env and update the values as needed

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB_NAME=testing1
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# Keycloak Configuration (if using OAuth2)
KEYCLOAK_URL=http://localhost:8571/
KEYCLOAK_SERVER_URL=http://localhost:8571
KEYCLOAK_REALM=banking-service
KEYCLOAK_CLIENT_ID=your_keycloak_client_id_here
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret_here

# JWT Security
JWT_SECRET=your_jwt_secret_here_at_least_256_bits

# Service Registry
EUREKA_URL=http://localhost:8761/eureka/

# API Gateway
API_GATEWAY_URL=http://localhost:8088

# Frontend
REACT_APP_API_BASE_URL=http://localhost:8088